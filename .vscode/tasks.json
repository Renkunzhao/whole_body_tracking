{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "input_file",
      "type": "promptString",
      "description": "Type input motion file path",
      "default": ""
    },
    {
      "id": "input_fps",
      "type": "promptString",
      "description": "Type input motion FPS",
      "default": "50"
    },
    {
      "id": "output_name",
      "type": "promptString",
      "description": "Type output motion name",
      "default": ""
    },
    {
      "id": "registry_name",
      "type": "promptString",
      "description": "Type wandb motion registry name",
      "default": ""
    },
    {
      "id": "Task",
      "type": "pickString",
      "description": "Select task name",
      "default": "Tracking-Flat-G1-v0",
      "options": [
        "Tracking-Flat-G1-v0",
        "Tracking-Flat-G1-Wo-State-Estimation-v0",
        "Tracking-Flat-G1-Low-Freq-v0",
        "Tracking-Trampoline-G1-v0",
        "Tracking-Flat-Go2-v0",
        "Tracking-Flat-Go2-Wo-State-Estimation-v0",
        "Tracking-Trampoline-Go2-v0",
        "Tracking-Trampoline-Go2-Wo-State-Estimation-v0",
        "Hopping-Flat-Go2-v0",
        "Hopping-Trampoline-Go2-v0",
        "Go2-Hopping-Flat",
        "Go2-Hopping-Trampoline",
        "Go2-Rebounce-Flat",
        "Go2-Rebounce-Trampoline",
        "Go2-Rebounce-Trampoline-history",
        "Go2-Rebounce-Trampoline-Teacher",
        "Go2-Rebounce-Trampoline-Student",
        "Go2-Rebounce-Trampoline-RNN",
        "Go2-Rebounce-Trampoline-RNN-Teacher",
        "Go2-Rebounce-Trampoline-RNN-Student",
        "Tracking-Flat-Go2-Jump-Wo-State-Estimation-v0",
        "Tracking-Trampoline-Go2-Jump-Wo-State-Estimation-v0"
      ]
    },
    {
      "id": "video_interval",
      "type": "promptString",
      "description": "Type video interval",
      "default": "2000",
    },
    {
      "id": "num_envs",
      "type": "promptString",
      "description": "Type number of environments",
      "default": "1",
    },
    {
      "id": "wandb_path",
      "type": "promptString",
      "description": "Type wandb run path",
      "default": ""
    },
    {
      "id": "load_run",
      "type": "promptString",
      "description": "Type local run folder",
      "default": ""
    },
    {
      "id": "checkpoint",
      "type": "promptString",
      "description": "Type local checkpoint",
      "default": "model_.*.pt"
    },
    {
      "id": "mode",
      "type": "pickString",
      "description": "Select hopping play mode",
      "default": "fixed",
      "options": [
        "fixed",
        "apex",
        "stance"
      ]
    },
    {
      "id": "rebounce_target_height",
      "type": "promptString",
      "description": "Type rebounce target height",
      "default": "0.85"
    },
    {
      "id": "rebounce_drop_height",
      "type": "promptString",
      "description": "Type rebounce reset drop height",
      "default": "0.85"
    },
    {
      "id": "trampoline_youngs_modulus",
      "type": "promptString",
      "description": "Type trampoline Young's modulus",
      "default": "8.0e4"
    },
    {
      "id": "trampoline_mass",
      "type": "promptString",
      "description": "Type trampoline mass",
      "default": "10.0"
    },
    {
      "id": "trampoline_dynamic_friction",
      "type": "promptString",
      "description": "Type trampoline dynamic friction",
      "default": "0.8"
    },
    {
      "id": "trampoline_elasticity_damping",
      "type": "promptString",
      "description": "Type trampoline elasticity damping",
      "default": "0.02"
    },
    {
      "id": "trampoline_damping_scale",
      "type": "promptString",
      "description": "Type trampoline damping scale",
      "default": "1.0"
    },
    {
      "id": "trampoline_poissons_ratio",
      "type": "promptString",
      "description": "Type trampoline Poisson's ratio",
      "default": "0.35"
    },
  ],
  "tasks": [
    {
      "label": "Convert Motion",
      "type": "shell",
      "command": "conda",
      "args": [
        "run",
        "--no-capture-output",
        "-n", "isaaclab",
        "python", "csv_to_npz.py",
        "--input_file", "${input:input_file}", 
        "--input_fps", "${input:input_fps}", 
        "--output_name", "wbt-${input:output_name}", 
      ],
      "options": { "cwd": "${workspaceFolder}/scripts" },
      "problemMatcher": []
    },
    {
      "label": "Replay Motion",
      "type": "shell",
      "command": "conda",
      "args": [
        "run",
        "--no-capture-output",
        "-n", "isaaclab",
        "python", "replay_npz.py",
        "--registry_name", "${input:registry_name}"
      ],
      "options": { "cwd": "${workspaceFolder}/scripts" },
      "problemMatcher": []
    },
    {
      "label": "Convert Motion (Go2)",
      "type": "shell",
      "command": "conda",
      "args": [
        "run",
        "--no-capture-output",
        "-n", "isaaclab",
        "python", "convert_gc_go2.py",
        "--input_file", "${input:input_file}", 
        "--input_fps", "${input:input_fps}", 
        "--output_name", "wbt-${input:output_name}", 
      ],
      "options": { "cwd": "${workspaceFolder}/scripts" },
      "problemMatcher": []
    },
    {
      "label": "Train (GPU 0)",
      "type": "shell",
      "command": "conda",
      "args": [
        "run",
        "--no-capture-output",
        "-n", "isaaclab",
        "python", "rsl_rl/train.py",
        "--task", "${input:Task}",
        "--headless",
        // "env.viewer.origin_type=world",
        // "--video",
        // "--video_interval", "${input:video_interval}",
        // "--registry_name", "${input:ion}",
        // "--wandb_path", "${input:wandb_path}",
        "--logger", "wandb", 
        "--log_project_name", "WBT", 
        "--run_name", "wbt-${input:output_name}"
      ],
      "options": { "cwd": "${workspaceFolder}/scripts", "env": { "CUDA_VISIBLE_DEVICES": "0" } },
      "problemMatcher": []
    },
    {
      "label": "Train (GPU 1)",
      "type": "shell",
      "command": "conda",
      "args": [
        "run",
        "--no-capture-output",
        "-n", "isaaclab",
        "python", "rsl_rl/train.py",
        "--task", "${input:Task}",
        "--headless",
        // "env.viewer.origin_type=world",
        // "--video",
        // "--video_interval", "${input:video_interval}",
        // "--registry_name", "${input:ion}",
        // "--wandb_path", "${input:wandb_path}",
        // "--device", "cuda:1",
        "--logger", "wandb",
        "--log_project_name", "WBT",
        "--run_name", "wbt-${input:output_name}"
      ],
      "options": { "cwd": "${workspaceFolder}/scripts", "env": { "CUDA_VISIBLE_DEVICES": "1" } },
      "problemMatcher": []
    },
    { 
      "label": "Train Distill Local Teacher (GPU 0)",
      "type": "shell",
      "command": "conda",
      "args": [
        "run",
        "--no-capture-output",
        "-n", "isaaclab",
        "python", "rsl_rl/train.py",
        "--task", "${input:Task}",
        "--headless",
        "--resume", "True",
        "--load_run", "${input:load_run}",
        "--checkpoint", "${input:checkpoint}",
        "--logger", "wandb",
        "--log_project_name", "WBT",
        "--run_name", "wbt-${input:output_name}"
      ],
      "options": { "cwd": "${workspaceFolder}/scripts", "env": { "CUDA_VISIBLE_DEVICES": "0" } },
      "problemMatcher": []
    },
    {
      "label": "Play",
      "type": "shell",
      "command": "conda",
      "args": [
        "run",
        "--no-capture-output",
        "-n", "isaaclab",
        "python", "rsl_rl/play.py",
        "--task", "${input:Task}",
        "--num_envs", "${input:num_envs}", 
        "--wandb_path", "${input:wandb_path}",
        "--command_vx", "1.0",
        "--command_vy", "0",
        "--command_yaw", "0",
        // "env.actions.foot_contact.contact_enabled=true",
      ],
      "options": { "cwd": "${workspaceFolder}/scripts" },
      "problemMatcher": []
    },
    {
      "label": "Play (Tracking)",
      "type": "shell",
      "command": "conda",
      "args": [
        "run",
        "--no-capture-output",
        "-n", "isaaclab",
        "python", "rsl_rl/play-tracking.py",
        "--task", "${input:Task}",
        "--wandb_path", "${input:wandb_path}",
      ],
      "options": { "cwd": "${workspaceFolder}/scripts" },
      "problemMatcher": []
    },
    {
      "label": "Play (Hopping)",
      "type": "shell",
      "command": "conda",
      "args": [
        "run",
        "--no-capture-output",
        "-n", "isaaclab",
        "python", "rsl_rl/play-hopping.py",
        "--task", "${input:Task}",
        "--wandb_path", "${input:wandb_path}",
        "--mode", "${input:mode}",
      ],
      "options": { "cwd": "${workspaceFolder}/scripts" },
      "problemMatcher": []
    },
    {
      "label": "Play (Rebounce)",
      "type": "shell",
      "command": "conda",
      "args": [
        "run",
        "--no-capture-output",
        "-n", "isaaclab",
        "python", "rsl_rl/play-rebounce.py",
        "--task", "${input:Task}",
        // "--wandb_path", "${input:wandb_path}",
        "--load_run", "${input:load_run}",
        "--target_height", "${input:rebounce_target_height}",
        // "--drop_height", "${input:rebounce_drop_height}",
        "--youngs_modulus", "${input:trampoline_youngs_modulus}",
        "--trampoline_mass", "${input:trampoline_mass}",
        "--dynamic_friction", "${input:trampoline_dynamic_friction}",
        "--elasticity_damping", "${input:trampoline_elasticity_damping}",
        "--damping_scale", "${input:trampoline_damping_scale}",
        "--poissons_ratio", "${input:trampoline_poissons_ratio}",
        // "--mode", "${input:mode}",
      ],
      "options": { "cwd": "${workspaceFolder}/scripts" },
      "problemMatcher": []
    },
    {
      "label": "Eval (Rebounce)",
      "type": "shell",
      "command": "conda",
      "args": [
        "run",
        "--no-capture-output",
        "-n", "isaaclab",
        "python", "rsl_rl/eval-rebounce.py",
        "--task", "${input:Task}",
        // "--wandb_path", "${input:wandb_path}",
        "--load_run", "${input:load_run}",
        "--num_envs", "64",
        "--episodes_per_condition", "64",
        "--target_height", "0.85",
        "--youngs_modulus", "4e4",
        "--trampoline_mass", "10",
        "--dynamic_friction", "0.75",
        "--elasticity_damping", "0.05",
        "--damping_scale", "1.0",
        "--poissons_ratio", "0.35",
        "--sweep", "target_height", "0.5", "0.85", "1.2",
        "--sweep", "youngs_modulus", "2e4", "4e4", "8e4",
        // "--sweep", "mass", "5", "10", "15",
        // "--sweep", "dynamic_friction", "0.3", "0.75", "1.2",
        "--sweep", "elasticity_damping", "0.01", "0.05", "0.1",
        // "--sweep", "poissons_ratio", "0.25", "0.35", "0.45",
        "--csv_path", "${workspaceFolder}/rebounce_eval.csv",
        "--progress_interval", "16",
      ],
      "options": { "cwd": "${workspaceFolder}/scripts" },
      "problemMatcher": []
    },
  ]
}
